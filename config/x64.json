{
  "$schema": "./config.schema.json",
  "architecture": "x64",
  "bitness": 64,
  "msysEnv": "UCRT64",
  "componentSelection": true,
  "downloads": [
    {
      "name": "Arm GNU Toolchain",
      "file": "arm-gnu-toolchain-15.3.rel2-mingw-w64-x86_64-arm-none-eabi.zip",
      "href": "https://gitlab.arm.com/api/v4/projects/tooling%2Fgnu-toolchains-for-arm/packages/generic/gnu-toolchain/15.3.rel2/arm-gnu-toolchain-15.3.rel2-mingw-w64-x86_64-arm-none-eabi.zip",
      "dirName": "arm-gnu-toolchain",
      "installLevel": 1
    },
    {
      "name": "CMake",
      "file": "cmake-4.4.4-windows-x86_64.msi",
      "exec": "msiexec /i \"$0\" /qn /norestart ADD_CMAKE_TO_PATH=System",
      "href": "https://github.com/Kitware/CMake/releases/download/v4.4.4/cmake-4.4.4-windows-x86_64.msi",
      "installLevel": 1
    },
    {
      "name": "Ninja",
      "file": "ninja-win.zip",
      "href": "https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-win.zip",
      "dirName": "ninja",
      "installLevel": 1
    },
    {
      "name": "Python 3.14",
      "file": "python-3.14.8-amd64.exe",
      "exec": "\"$0\" /quiet InstallAllUsers=1 PrependPath=1",
      "href": "https://www.python.org/ftp/python/3.14.8/python-3.14.8-amd64.exe",
      "installLevel": 3
    },
    {
      "name": "Git for Windows",
      "file": "Git-2.56.0.2-64-bit.exe",
      "exec": "\"$0\" /VERYSILENT /NORESTART /NOCANCEL /SP- /CLOSEAPPLICATIONS /RESTARTAPPLICATIONS /SKIPDOWNGRADE=1 \"/LOADINF=$PLUGINSDIR\\git.inf\"",
      "href": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.2/Git-2.56.0.2-64-bit.exe",
      "additionalFiles": [
        "packages\\pico-setup-windows\\git.inf"
      ],
      "installLevel": 3
    }
  ]
}
